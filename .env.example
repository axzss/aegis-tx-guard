# Aegis — run it (BSC mainnet by default)
PORT=3000
# Public JSON-RPC endpoint used for eth_getCode + eth_call.
# Default is the public BSC dataseed (no key). Point at your own node for
# lower latency / higher reliability.
RPC_URL=https://bsc-dataseed.binance.org/
# Comma-separated blocklisted addresses (lowercase or mixed case). The zero
# address is always blocklisted. Add drainer / scam contracts here.
BLOCKLIST=
# Optional: HMAC secret for signing responses (x-agent-games-signature).
# Leave empty for the public demo endpoint.
AGENT_GAMES_HMAC_SECRET=
# Optional: Kurier mainnet API key. When set, the guard vk is registered
# once (data/vk-hash.json) and every proof is submitted to Kurier and
# polled until Finalized. Without it, proofs are generated locally and
# returned in the response, but NOT submitted on-chain.
KURIER_API_KEY=
KURIER_NETWORK=mainnet
PROOF_TIMEOUT_MS=30000
KURIER_POLL_TIMEOUT_MS=20000
